{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DW Bar",
  "version": "0.1.0",
  "identifier": "app.dwbar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "DW Bar",
    "category": "Utility",
    "shortDescription": "AI 用量膠囊，常駐 Windows 工作列",
    "longDescription": "DW Bar 把 Claude Code、Codex 等 AI 的 5 小時與每週額度顯示在工作列上。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["TradChinese", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["zh-TW", "en-US"]
      }
    }
  }
}
