<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store. Identity values come from
  Partner Center → DW Bar → Product identity. __VERSION__ and __ARCH__ are filled in by CI.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="Axiang.DwBar"
    Publisher="CN=969B6364-C304-4C13-8FBE-F2CC57460EC1"
    Version="__VERSION__"
    ProcessorArchitecture="__ARCH__" />

  <Properties>
    <DisplayName>DW Bar</DisplayName>
    <PublisherDisplayName>Axiang</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="zh-tw" />
    <Resource Language="zh-cn" />
  </Resources>

  <Applications>
    <Application Id="DWBar" Executable="dw-bar.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="DW Bar"
        Description="AI usage limits (Claude, Codex, Gemini and more) in your taskbar."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          ShortName="DW Bar" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- 開機時啟動: enabled from DW Bar's settings through the StartupTask API. -->
        <desktop:Extension Category="windows.startupTask" Executable="dw-bar.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="DWBarStartup" Enabled="false" DisplayName="DW Bar" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
